{
  "name": "obsidian-nautilus-log",
  "version": "0.1.2",
  "description": "Nautilus spiral day planner for Obsidian (port of the Roam Research Nautilus extension)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "esbuild test/logic.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/logic.test.cjs --log-level=warning && node node_modules/.cache/logic.test.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
